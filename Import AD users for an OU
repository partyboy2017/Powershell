Import-Module ActiveDirectory

$CsvPath = Read-Host "Enter path to completed CSV file"

$Users = Import-Csv $CsvPath

foreach ($User in $Users) {

    try {

        $Params = @{
            Identity = $User.SamAccountName
        }

        if ($User.City)            { $Params.City = $User.City }
        if ($User.State)           { $Params.State = $User.State }
        if ($User.Address)         { $Params.StreetAddress = $User.Address }
        if ($User.Email)           { $Params.EmailAddress = $User.Email }
        if ($User.TelephoneNumber) { $Params.OfficePhone = $User.TelephoneNumber }
        if ($User.ZipCode)         { $Params.PostalCode = $User.ZipCode }
        if ($User.JobTitle)        { $Params.Title = $User.JobTitle }

        Set-ADUser @Params

        Write-Host "Updated $($User.SamAccountName)" -ForegroundColor Green
    }
    catch {
    Write-Host "Failed: $($User.SamAccountName)" -ForegroundColor Red
    Write-Host $_.Exception.Message -ForegroundColor Yellow
}}
