Import-Module ActiveDirectory

# Prompt for CSV file
$CsvPath = Read-Host "Enter path to completed CSV file"

if (-not (Test-Path $CsvPath)) {
    Write-Host "File not found: $CsvPath" -ForegroundColor Red
    exit
}

$Users = Import-Csv $CsvPath

foreach ($User in $Users) {

    try {
        Write-Host "Updating $($User.SamAccountName)..." -ForegroundColor Cyan

        Set-ADUser `
            -Identity $User.SamAccountName `
            -City $User.City `
            -State $User.State `
            -StreetAddress $User.Address `
            -EmailAddress $User.Email `
            -OfficePhone $User.TelephoneNumber `
            -PostalCode $User.ZipCode `
            -Title $User.JobTitle

        Write-Host "Updated $($User.SamAccountName)" -ForegroundColor Green
    }
    catch {
        Write-Host "Failed to update $($User.SamAccountName): $($_.Exception.Message)" -ForegroundColor Red
    }
}
